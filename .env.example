# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.

# Sepolia RPC (e.g. from Alchemy or Infura — use the key from their dashboard)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE

# Deployer private key — export from MetaMask (testnet wallet only!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE
